# Python environments, including backups created by setup.ps1
.venv/
.venv.previous-*/
venv/
env/
.python-version

# Python bytecode and generated package metadata
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# Build products and generated portable archives
/build/
/dist/

# Local runtime state, history, research files, and generated outputs
/.runtime/
/artifacts/
/downloads/
/.cache/
*.log
*.log.*

# Machine-specific MCP configurations generated by configuration.py
/codex-mcp.toml
/mcp-config.json
/.mcp.json
/.codex/

# Local environment variables; keep documented templates publishable
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Local authentication material and private certificates
.auth/
.secrets/
.credentials/
credentials.json
secrets.json
token.json
tokens.json
cookies.json
cookies.txt
*.pem
*.key
*.p12
*.pfx

# Browser profiles and login sessions must remain local
/profiles/
/browser-data/
/user-data/

# Test, coverage, lint, and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
/htmlcov/
/coverage.xml
/junit.xml

# Personal editor settings, swap files, and operating-system metadata
/.idea/
/.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Commit source, tests, documentation, pyproject.toml, and requirements-lock.txt.

